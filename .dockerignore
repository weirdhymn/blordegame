# Installed inside the image; never copy host modules over the container's.
node_modules
**/node_modules

# VCS + local tooling
.git
.github
.vscode
.idea

# Build output (the web client is rebuilt inside the image) + local PGlite data + logs
**/dist
**/.cache
**/.data
**/*.log
**/*.local

# OS cruft
.DS_Store
Thumbs.db
