{
  "name": "@blorse/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BLORSE server — Fastify + Drizzle + auth + game logic + autonomy sim.",
  "scripts": {
    "dev": "node --import ./scripts/register.mjs --watch src/index.ts",
    "start": "node --import ./scripts/register.mjs src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register.mjs test/server.test.ts",
    "seed": "node --import ./scripts/register.mjs scripts/seed.ts",
    "set-admin": "node --import ./scripts/register.mjs scripts/set-admin.ts",
    "backup": "node --import ./scripts/register.mjs scripts/backup.ts",
    "restore": "node --import ./scripts/register.mjs scripts/restore.ts",
    "restore-drill": "node --import ./scripts/register.mjs scripts/restore-drill.ts",
    "compare-db": "node --import ./scripts/register.mjs scripts/compare-db.ts",
    "canary": "node --import ./scripts/register.mjs scripts/canary.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@blorse/balance": "workspace:*",
    "@blorse/genetics": "workspace:*",
    "@blorse/render-core": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.1"
  }
}
