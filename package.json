{
  "name": "blorse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "blorsegame (BLORSE) — a cozy async multiplayer life-sim of pixel horses. Monorepo root.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @blorse/web dev",
    "dev:server": "pnpm --filter @blorse/server dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^3.0.0"
  }
}
